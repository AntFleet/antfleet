# AntFleet environment configuration template.
# Copy to .env.local (gitignored) and fill in. No real values belong in this file.

# ─── CLI: provider credentials ─────────────────────────────────────────────
# Required when running `fleet review` / `fleet fix` against the corresponding
# provider. The CLI reads exactly one of these per run (selected via
# FLEET_PROVIDER or the `stacked` provider).
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# OpenRouter is not registered in providerByName; set these only if you import
# the openrouter provider directly.
OPENROUTER_API_KEY=
OPENROUTER_FALLBACK_MODEL=

# ─── CLI: behavior ─────────────────────────────────────────────────────────
# Selects a provider by name when running `fleet`. Defaults inside config.ts.
FLEET_PROVIDER=
FLEET_MODEL=
FLEET_CONFIG=
FLEET_STATE_DIR=
# Comma-separated child providers when FLEET_PROVIDER=stacked.
FLEET_STACKED_PROVIDERS=
# unanimous | majority | any — agreement gate for the stacked provider.
FLEET_STACKED_AGREEMENT=

# ─── apps/web: database ────────────────────────────────────────────────────
# Neon Postgres connection string (server-only; never exposed to the client).
# In .env.local, point this at a Neon DEV BRANCH forked from prod — NEVER at
# the prod compute endpoint. dev and prod currently share one DB; every
# local `pnpm dev`, hand-run query, and `apply-migration-*.ts --apply`
# writes to prod until the split lands.
# Use the pooled hostname (`-pooler` suffix) for prod parity — the web
# app and migration scripts use `@neondatabase/serverless`'s HTTP
# transport, which accepts either, but prod runs against the pooler.
# Vercel project env vars (prod) keep the prod URL; only `.env.local` swaps.
# Operator setup: see `audit/RUNBOOK-dev-db-split.md` (gitignored,
# operator-only). Until the split lands, gate T1.4/QW4/QW5 behind it.
DATABASE_URL=

# ─── apps/web: GitHub App ──────────────────────────────────────────────────
GITHUB_APP_ID=
# Multi-line PEM. In .env.local use \n-encoded form or wrap with quotes.
GITHUB_APP_PRIVATE_KEY=
GITHUB_APP_WEBHOOK_SECRET=
# Public installation URL surfaced on the marketing page.
GITHUB_APP_INSTALL_URL=

# ─── apps/web: cron + onboarder ────────────────────────────────────────────
# Shared secret Vercel's cron scheduler sends as `Authorization: Bearer <…>`.
CRON_SECRET=
# Onboarder agent gate. Unset / empty = silent in prod.
ONBOARDER_ENABLED=
# Optional canonical override for absolute links the Onboarder embeds in
# GitHub comments (currently the public-receipts opt-in link). Defaults to
# https://$VERCEL_PROJECT_PRODUCTION_URL in prod, http://localhost:3000 locally.
ANTFLEET_PUBLIC_BASE_URL=
# HMAC secret used to sign the public-receipts opt-in link the Onboarder
# embeds in first-review summary comments. Generate with:
#   openssl rand -base64 32
# Treat as a bearer credential: leaking it lets anyone flip opt-in for any
# installed repo for 30 days.
OPTIN_HMAC_SECRET=
# Personal access token for the antfleet-ops GitHub user. Used by the cron
# sweep to poll the merge state of outgoing PRs that antfleet-ops opens on
# third-party repos (where the AntFleet App is not installed). Read-only
# scope is enough — `public_repo` covers the public upstream targets, or
# `repo` for private ones. Treat this as a bearer credential; the same
# account is shared with manual `gh` work, so exhausting its rate limit
# disrupts the operator. Unset = the outgoing-PR poll skips silently
# (degraded but not failing the cron).
ANTFLEET_OPS_GH_TOKEN=
# Coordinated disclosure gate. Unset / empty = off. Bench runs can set true;
# prod must stay false until the migration/backfill and operator runbook are
# complete.
ANTFLEET_DISCLOSURE_GATE=
# Second-stage runtime guard for the disclosure gate. Set true only after
# migration 0044 has been applied and backfill-finding-disclosure completed.
ANTFLEET_DISCLOSURE_BACKFILL_COMPLETE=
# HMAC secret used to sign private maintainer disclosure URLs. If unset, the
# private disclosure route cannot sign or verify maintainer links. Keep this
# separate from OPTIN_HMAC_SECRET.
DISCLOSURE_HMAC_SECRET=
# Dry-run GHSA client mode for bench/dev runs. true = no GitHub advisory/CVE
# writes; the client logs mock advisory + CVE-request events instead.
ANTFLEET_GHSA_MOCK=

# ─── apps/web: alerting ────────────────────────────────────────────────────
# Optional webhook URL for critical-event alerts (Slack/Discord/generic POST).
# When set, alertCritical() fires a fire-and-forget POST for terminal worker
# failures, cron failures, and debit/settlement errors. Unset = silent no-op.
# Example Slack incoming webhook: https://hooks.slack.com/services/T.../B.../...
ANTFLEET_ALERT_WEBHOOK_URL=
