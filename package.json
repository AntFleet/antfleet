{
  "name": "@antfleet/cli",
  "version": "0.2.0",
  "description": "AntFleet — trust substrate for autonomous code",
  "license": "MIT",
  "bin": {
    "fleet": "dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "exports": {
    "./detect": {
      "types": "./dist/detect.d.ts",
      "default": "./dist/detect.js"
    },
    "./mapper": {
      "types": "./dist/mapper.d.ts",
      "default": "./dist/mapper.js"
    },
    "./provider": {
      "types": "./dist/provider.d.ts",
      "default": "./dist/provider.js"
    },
    "./providers/stacked": {
      "types": "./dist/providers/stacked.d.ts",
      "default": "./dist/providers/stacked.js"
    },
    "./providers/agreement": {
      "types": "./dist/providers/agreement.d.ts",
      "default": "./dist/providers/agreement.js"
    },
    "./providers/patch-gate": {
      "types": "./dist/providers/patch-gate.d.ts",
      "default": "./dist/providers/patch-gate.js"
    },
    "./providers/anthropic": {
      "types": "./dist/providers/anthropic.d.ts",
      "default": "./dist/providers/anthropic.js"
    },
    "./providers/openai": {
      "types": "./dist/providers/openai.d.ts",
      "default": "./dist/providers/openai.js"
    },
    "./spike/build-prompt": {
      "types": "./dist/spike/build-prompt.d.ts",
      "default": "./dist/spike/build-prompt.js"
    },
    "./spike/cost": {
      "types": "./dist/spike/cost.d.ts",
      "default": "./dist/spike/cost.js"
    },
    "./types": {
      "types": "./dist/types.d.ts",
      "default": "./dist/types.js"
    }
  },
  "scripts": {
    "build": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.build.json",
    "prepack": "pnpm -s build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "oxlint . --config oxlint.json",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "test": "vitest run",
    "spike": "tsx scripts/spike.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.96.0",
    "dotenv": "^17.4.2",
    "openai": "^6.39.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "oxfmt": "^0.49.0",
    "oxlint": "^1.64.0",
    "tsx": "^4.22.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.6"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@11.1.2"
}
