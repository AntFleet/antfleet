{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "crons": [
    {
      "path": "/api/cron/sweep",
      "schedule": "0 6 * * *"
    },
    {
      "path": "/api/cron/review-retry",
      "schedule": "*/2 * * * *"
    },
    {
      "path": "/api/cron/drift",
      "schedule": "0 * * * *"
    },
    {
      "path": "/api/cron/curate-weekly",
      "schedule": "0 0 * * 1"
    },
    {
      "path": "/api/cron/scan-deposits",
      "schedule": "* * * * *"
    },
    {
      "path": "/api/cron/review-jobs",
      "schedule": "* * * * *"
    },
    {
      "path": "/api/cron/scorecard-snapshot",
      "schedule": "0 0 * * 6"
    },
    {
      "path": "/api/cron/patch-cost-reconcile",
      "schedule": "0 2 * * 1"
    },
    {
      "path": "/api/cron/regression-fixtures",
      "schedule": "0 4 * * 1"
    }
  ]
}
