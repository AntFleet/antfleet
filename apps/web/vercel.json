{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "crons": [
    {
      "path": "/api/cron/sweep",
      "schedule": "0 6 * * *"
    },
    {
      "path": "/api/cron/review-retry",
      "schedule": "*/2 * * * *"
    },
    {
      "path": "/api/cron/drift",
      "schedule": "0 * * * *"
    },
    {
      "path": "/api/cron/roast",
      "schedule": "*/30 * * * *"
    },
    {
      "path": "/api/cron/curate-weekly",
      "schedule": "0 0 * * 1"
    }
  ]
}
